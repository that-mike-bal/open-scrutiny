  "precedent_analysis": {
    "strong_precedents": [
      {
        "principle": "Capital city names require government approval",
        "supporting_cases": ["roma", "paris", "london", "berlin"],
        "reliability": "Very High",
        "application": "Any capital city name should expect GAC warning without approval"
      },
      {
        "principle": "Religious terms require community consultation",
        "supporting_cases": ["islam", "catholic", "halal"],
        "reliability": "High",
        "application": "Religious terminology needs community endorsement"
      },
      {
        "principle": "Indigenous names require community consent",
        "supporting_cases": ["aboriginal", "maori"],
        "reliability": "High",
        "application": "Indigenous community names need explicit consent"
      },
      {
        "principle": "Geographic features can be contested by multiple countries",
        "supporting_cases": ["amazon", "patagonia"],
        "reliability": "High",
        "application": "Cross-border geographic names face complex approval"
      }
    ],
