{
  "metadata": {
    "description": "String similarity analysis for gTLD conflict detection",
    "last_updated": "2024-06-13",
    "version": "2.0",
    "methodology": "Multiple similarity algorithms and visual confusion analysis",
    "threshold_high_risk": 0.8,
    "threshold_medium_risk": 0.6
  },
  "similarity_algorithms": {
    "visual_similarity": {
      "description": "Character shape and visual appearance similarity",
      "weight": 0.4,
      "factors": [
        "Character substitution (o/0, l/1, rn/m)",
        "Font rendering differences",
        "Case sensitivity variations",
        "Diacritic mark similarities"
      ]
    },
    "phonetic_similarity": {
      "description": "Pronunciation and sound similarity",
      "weight": 0.3,
      "algorithms": ["Soundex", "Metaphone", "Double Metaphone"],
      "factors": [
        "Consonant clusters",
        "Vowel patterns",
        "Syllable structure",
        "Stress patterns"
      ]
    },
    "edit_distance": {
      "description": "Levenshtein distance and variations",
      "weight": 0.2,
      "factors": [
        "Character insertions",
        "Character deletions", 
        "Character substitutions",
        "Transpositions"
      ]
    },
    "semantic_similarity": {
      "description": "Meaning and conceptual similarity",
      "weight": 0.1,
      "factors": [
        "Synonyms and related terms",
        "Translation equivalents",
        "Industry terminology",
        "Cultural associations"
      ]
    }
  },
  "high_risk_patterns": {
    "character_substitution": [
      {
        "pattern": "o/0 substitution",
        "examples": [
          {"original": "google", "variant": "g00gle", "similarity": 0.92},
          {"original": "yahoo", "variant": "yah00", "similarity": 0.89}
        ],
        "risk_level": 4.5
      },
      {
        "pattern": "l/1 substitution", 
        "examples": [
          {"original": "apple", "variant": "app1e", "similarity": 0.91},
          {"original": "intel", "variant": "inte1", "similarity": 0.88}
        ],
        "risk_level": 4.3
      },
      {
        "pattern": "rn/m confusion",
        "examples": [
          {"original": "amazon", "variant": "arnazon", "similarity": 0.87},
          {"original": "walmart", "variant": "walrnart", "similarity": 0.85}
        ],
        "risk_level": 4.0
      }
    ],
    "homograph_attacks": [
      {
        "type": "Cyrillic substitution",
        "examples": [
          {"original": "apple", "variant": "аpple", "similarity": 0.95, "note": "Cyrillic 'а'"},
          {"original": "google", "variant": "gооgle", "similarity": 0.94, "note": "Cyrillic 'о'"}
        ],
        "risk_level": 4.8
      },
      {
        "type": "Greek substitution",
        "examples": [
          {"original": "microsoft", "variant": "micrοsoft", "similarity": 0.93, "note": "Greek 'ο'"},
          {"original": "amazon", "variant": "αmazon", "similarity": 0.92, "note": "Greek 'α'"}
        ],
        "risk_level": 4.6
      }
    ],
    "typosquatting_patterns": [
      {
        "type": "Adjacent key errors",
        "examples": [
          {"original": "facebook", "variant": "facwbook", "similarity": 0.82},
          {"original": "twitter", "variant": "twittwr", "similarity": 0.84}
        ],
        "risk_level": 3.8
      },
      {
        "type": "Double character",
        "examples": [
          {"original": "google", "variant": "gooogle", "similarity": 0.86},
          {"original": "apple", "variant": "appple", "similarity": 0.83}
        ],
        "risk_level": 3.5
      }
    ]
  },
