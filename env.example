# Environment configuration template (backend). Copy to .env and fill in.

# =============================================================================
# API Keys (Required)
# =============================================================================

# OpenAI API Key for GPT models (fallback for report generation)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key for primary report generation
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
# Backend only — never expose the service-role key via a VITE_* / client-side variable.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# Search APIs
SERPER_API_KEY=your_serper_dev_api_key
BRAVE_API_KEY=your_brave_search_api_key

# Firecrawl (optional — used by the Firecrawl MCP tool)
FIRECRAWL_API_KEY=your_firecrawl_api_key

# Trademark and Patent APIs
USPTO_API_KEY=your_uspto_api_key

# Anthropic Claude API (if used)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Drive export of reports (optional)
# GOOGLE_SERVICE_ACCOUNT_PATH=/path/to/service-account.json
# GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id

# =============================================================================
# Application Configuration
# =============================================================================

# Environment (development, staging, production)
ENVIRONMENT=production

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable debug mode (true/false)
DEBUG_MODE=false

# CORS: comma-separated list of origins allowed to call the backend API.
# Defaults to local dev origins when unset; set your production origin(s) here.
# Never use "*" together with credentials.
CORS_ALLOW_ORIGINS=http://localhost:5173
# Optional regex for matching deploy subdomains (defaults to Render):
# CORS_ALLOW_ORIGIN_REGEX=https://.*\.onrender\.com

# =============================================================================
# Frontend Configuration
# =============================================================================

# Backend API endpoint for frontend (use public URL for production)
VITE_CREWAI_ENDPOINT=http://localhost:8000
